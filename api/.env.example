# Copy to .env and adjust. Bun loads .env automatically — no dotenv package needed.

# Port the Express server listens on.
PORT=3000

# Origin allowed to call this API (your frontend's dev/prod URL).
CORS_ORIGIN=http://localhost:5173

# Ollama server this API talks to for chat  tool-calling.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:12b

# Safety cap on the tool-calling loop per workflow step.
MAX_TOOL_ITERATIONS=8

# Required only if a workflow step uses the get_weather tool.
WEATHER_API_KEY=